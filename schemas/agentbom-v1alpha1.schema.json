{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opscustodian.dev/schemas/agentbom-v1alpha1.schema.json",
  "title": "OpsCustodian Agent BOM",
  "description": "Experimental vendor-neutral inventory of agentic operational access.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "assets"],
  "properties": {
    "apiVersion": { "const": "opscustodian.dev/v1alpha1" },
    "kind": { "const": "AgentBOM" },
    "metadata": { "$ref": "#/$defs/documentMetadata" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "documentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generator": { "type": "string", "minLength": 1 },
        "normalizationVersion": { "type": "string", "minLength": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "source", "capabilities", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["agent", "workflow", "mcp-server", "skill", "instruction-set"] },
        "name": { "type": "string", "minLength": 1 },
        "owners": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "source": { "$ref": "#/$defs/source" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "credentials": {
          "type": "array",
          "items": { "$ref": "#/$defs/credentialReference" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "parameters": { "type": "object" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "type", "to", "targetType", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "type": { "enum": ["uses-tool", "uses-mcp-server", "uses-credential", "depends-on", "owned-by"] },
        "to": { "type": "string", "minLength": 1 },
        "targetType": { "enum": ["asset", "asset-reference", "tool", "credential", "owner"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "valueCaptured": {
          "const": false,
          "description": "Credential values are never valid Agent BOM content."
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource", "effect"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "effect": {
          "enum": ["observe", "read", "write", "delete", "admin", "execute", "unknown"]
        },
        "environment": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["repository", "organization", "kubernetes", "network", "workspace", "mcp-server", "unknown"] },
        "values": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "wildcard": { "type": "boolean" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "value": {}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "parser", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "parser": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "observation": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "parser": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
