{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opscustodian.dev/schemas/repository-set-v1alpha1.schema.json",
  "title": "OpsCustodian RepositorySet",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schedule", "repositories"],
  "properties": {
    "apiVersion": { "const": "opscustodian.dev/ingestion/v1alpha1" },
    "kind": { "const": "RepositorySet" },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval", "maxConcurrency", "retry"],
      "properties": {
        "interval": { "type": "string", "minLength": 1 },
        "maxJitter": { "type": "string" },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "repositoryTimeout": { "type": "string" },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "initialBackoff": { "type": "string" },
            "maxBackoff": { "type": "string" }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "connector", "location", "revision"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "connector": { "const": "local" },
          "location": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 512 },
          "boundaries": { "type": "array", "items": { "type": "string" } },
          "maxFileSize": { "type": "integer", "minimum": 0, "maximum": 104857600 }
        }
      }
    }
  }
}
